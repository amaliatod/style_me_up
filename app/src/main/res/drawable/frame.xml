<!-- frame.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#FFFFFF" /> <!-- Set the frame color, e.g., black -->
    <stroke android:width="5dp" android:color="#FB77C5" /> <!-- Set the frame border color and width, e.g., green -->
